{
  "name": "termrent",
  "version": "1.0.0",
  "description": "Bidirectional, cross-device, zero-config encrypted file exchange CLI",
  "type": "module",
  "bin": {
    "termrent": "./bin/termrent.js"
  },
  "main": "lib/server.js",
  "scripts": {
    "start": "node bin/termrent.js",
    "dev": "node bin/termrent.js --port 3000",
    "lint": "eslint .",
    "build": "node scripts/check.js",
    "test": "node --test test/*.test.js",
    "check": "npm run lint && npm run build && npm test && npm run test:e2e",
    "test:e2e": "playwright test"
  },
  "keywords": [
    "file-transfer",
    "encrypted",
    "websocket",
    "cli",
    "zero-config",
    "aes-gcm",
    "e2e-encryption"
  ],
  "license": "MIT",
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "bonjour-service": "^1.3.0",
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "files": [
    "bin/",
    "lib/",
    "public/",
    "README.md"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0"
  }
}
